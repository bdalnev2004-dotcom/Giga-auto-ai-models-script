{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Бот (polling)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bot.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Healthcheck (проверка ключей)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/healthcheck.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    }
  ]
}
