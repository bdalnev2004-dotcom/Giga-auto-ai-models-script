# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Claude (orchestrator brain) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/giga_farm

# --- Redis (FSM dialog state — required in prod, see bot.py) ---
REDIS_URL=redis://localhost:6379/0

# --- Vault (secret encryption key, 32-byte urlsafe base64 — use Fernet.generate_key()) ---
VAULT_ENCRYPTION_KEY=

# --- Google Drive ---
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/drive-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Global platform keys (account-specific creds live in the encrypted vault table, not here) ---
BLOTATO_API_KEY=
# HikerAPI — только чтение (аналитика/референсы). Постинг идёт через instagrapi.
HIKERAPI_ACCESS_KEY=
ELEVENLABS_API_KEY=
HIGGSFIELD_API_KEY=
VYRA_MCP_URL=

# --- Scheduling ---
TIMEZONE=Europe/Moscow
