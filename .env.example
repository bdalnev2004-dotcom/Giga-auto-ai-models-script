# Скопируй в .env и заполни. Файл .env в git не попадает (см. .gitignore).
#
# ВАЖНО про адреса: значения ниже — для запуска в Docker Compose, где Postgres и
# Redis доступны по именам сервисов. Для локального запуска без Docker замени
# postgres/redis на localhost.

# --- Telegram ---
# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# --- Claude (orchestrator brain) ---
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Database ---
# Пароль придумываешь сам; compose поднимет Postgres с ним же.
# Он же должен стоять внутри DATABASE_URL — это одно и то же значение в двух местах.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://giga:ЗАМЕНИ_НА_POSTGRES_PASSWORD@postgres:5432/giga_farm

# --- Redis (состояния диалогов; без него они теряются при рестарте) ---
REDIS_URL=redis://redis:6379/0

# --- Vault (ключ шифрования кредов аккаунтов) ---
# Не покупается, а генерируется:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потеряешь ключ — потеряешь все сохранённые пароли аккаунтов.
VAULT_ENCRYPTION_KEY=

# --- Google Drive ---
# JSON сервис-аккаунта положить в ./secrets/ — папка монтируется в контейнер на чтение.
# Не забудь расшарить корневую папку Drive на email сервис-аккаунта.
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/drive-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Ключи сервисов (креды конкретных аккаунтов — в зашифрованной таблице, не здесь) ---
# HikerAPI — только чтение (аналитика/референсы). Постинг идёт через instagrapi.
HIKERAPI_ACCESS_KEY=
ELEVENLABS_API_KEY=
# Higgsfield: авторизация из двух значений, при реализации адаптера поле разнесётся на два
HIGGSFIELD_API_KEY=
# Vyra headless не работает (OAuth в браузере) — поле пока мёртвое, см. CLAUDE.md
VYRA_MCP_URL=
# TikTok — вне текущего объёма
BLOTATO_API_KEY=

# --- Scheduling ---
TIMEZONE=Europe/Moscow
